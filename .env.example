# ==============================================================================
# AutoReport AI Configuration
# ==============================================================================

# Server Web Dashboard Port (For Mobile & Desktop access)
PORT=3000

# ==============================================================================
# OpenAI Configuration
# ==============================================================================
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Recommended: gpt-4o-mini (lightning fast, structured, highly cost-effective)
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# Dispatch Channels & Targets
# ==============================================================================
# Default Channel: 'whatsapp' | 'telegram' | 'console'
DEFAULT_DISPATCH_CHANNEL=whatsapp

# 1. WhatsApp Configuration:
# Set to 'false' if running on low-memory free cloud hosts (Render/Railway/Replit) without GUI/Chromium
ENABLE_WHATSAPP=true
# Recipient: Country code + phone without '+' or spaces (e.g. 15551234567 or 919876543210)
# Group ID: 120363025412345678@g.us
TARGET_PHONE_NUMBER=919876543210

# 2. Telegram Configuration (Cloud-native 0MB RAM, ideal for Render/Railway):
# Create a bot via @BotFather on Telegram to get your token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Your personal or channel Telegram Chat ID (obtain via @userinfobot)
TELEGRAM_CHAT_ID=123456789

# ==============================================================================
# Task Scheduling Configuration
# ==============================================================================
# Standard 5-part cron syntax: minute hour day-of-month month day-of-week
# Default: 18:00 (6:00 PM) from Monday to Friday -> 0 18 * * 1-5
CRON_SCHEDULE=0 18 * * 1-5

# ==============================================================================
# Work Log Ingestion Configuration
# ==============================================================================
LOG_FILE_PATH=./work_log.md
ENABLE_GIT_COMMITS=true
GIT_REPO_PATH=.
